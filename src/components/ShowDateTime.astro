---
import type { ShowListing } from "~/api/getShowListings";
import { formatShowTime } from "~/utils/formatShowTime";
import CalendarIcon from "../icons/calendar.svg";

type Props = {
  showDate: ShowListing["date"];
  class?: string;
};

const { showDate, class: className } = Astro.props;

const showDateFormatted = formatShowTime(showDate);
---

<style>
  .show_date_time {
    display: flex;
    gap: calc(var(--spacing) * 2);
    align-items: center;

    border-bottom: 2px solid var(--color-light-purple);
    color: var(--color-primary-purple);
    width: fit-content;
    padding: calc(var(--spacing) * 4) 0px;
  }

  p {
    font-family: var(--font-serif);
    font-weight: var(--font-weight-semibold);
  }

  .icon {
    size: calc(var(--spacing) * 5);
  }
</style>

<div class="show_date_time" class:list={className}>
  <CalendarIcon name="calendar" class="icon" />
  <p>{showDateFormatted}</p>
</div>
