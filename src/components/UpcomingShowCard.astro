---
import { documentToHtmlString } from "@contentful/rich-text-html-renderer";

import type { ShowListing } from "~/api/getShowListings";

import ShowDateTime from "./ShowDateTime.astro";
import LinkedImage from "./LinkedImage.astro";
import TicketIcon from "../icons/ticket.svg";

type Props = {
  showListing: ShowListing;
};

const { showListing } = Astro.props;
---

<style>
  .upcoming_show_card {
    min-width: calc(var(--spacing) * 78.75);
    max-width: calc(var(--spacing) * 125);
    overflow: hidden;

    border-radius: 0.25rem;
    padding: calc(var(--spacing) * 2);

    box-shadow: var(--shadow-lg);
    background-color: var(--color-peach);

    display: flex;
    flex-direction: column;
    gap: calc(var(--spacing) * 4);
    flex: 1;
  }

  .show_description {
    max-height: calc(var(--spacing) * 125);

    font-size: var(--text-lg);
    padding: 0px calc(var(--spacing) * 2);

    display: flex;
    flex-direction: column;
    gap: calc(var(--spacing) * 4);
  }

  .show_date_time {
    width: fit-content;
    margin-right: auto;
    padding: calc(var(--spacing) * 4) 0px;
  }

  .show_price {
    font-weight: var(--font-weight-bold);
    padding: 0px calc(var(--spacing) * 2);
  }

  .icon {
    size: calc(var(--spacing) * 5);
  }

  .wysiwyg {
    overflow: auto;
  }

  .coral_btn_link {
    width: 100%;
    min-width: 100%;
  }
</style>

<div class="upcoming_show_card">
  <LinkedImage
    listingImageSrc={showListing.image}
    listingTitle={showListing.name}
    href={showListing.listingUrl}
    width={724}
    height={407}
  />

  <div class="show_description">
    <ShowDateTime showDate={showListing.date} class="show_date_time" />

    {
      showListing.showDescription ? (
        <div
          class="wysiwyg"
          set:html={documentToHtmlString(showListing.showDescription)}
        />
      ) : null
    }
  </div>

  <p class="show_price">
    {showListing.price}
  </p>

  <a class="coral_btn_link" href={showListing.listingUrl}>
    <TicketIcon name="ticket" class="icon" />Get Tickets
  </a>
</div>
