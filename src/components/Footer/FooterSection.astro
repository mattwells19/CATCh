---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<style>
  section {
    flex: 1;
  }

  h2 {
    font-size: var(--text-2xl);
    font-style: var(--font-serif);
    color: var(--color-primary-purple);
    margin-bottm: calc(var(--spacing) * 5);
  }
</style>

<section>
  <h2>{title}</h2>
  <slot />
</section>
