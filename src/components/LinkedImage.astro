---
import { Image } from "astro:assets";

type Props = {
  href: string;
  listingTitle: string;
  listingImageSrc: string;
  height: number;
  width: number;
  class?: string;
};

const {
  href,
  listingTitle,
  listingImageSrc,
  height,
  width,
  class: className,
} = Astro.props;
---

<style>
  a {
    display: block;
    position: relative;
    background-color: var(--color-black);

    &:hover {
      & > span {
        opacity: 100%;
      }
      & > img {
        opacity: 20%;
      }
    }
  }

  span {
    position: absolute;
    z-index: 10;
    inset: 0;
    height: fit-content;

    text-align: center;
    color: var(--color-white);

    margin: auto;
    padding: 0px calc(var(--spacing) * 1);

    opacity: 0;
    transition: opacity var(--default-transition-timing-function)
      var(--default-transition-duration);
  }

  img {
    transition: opacity var(--default-transition-timing-function)
      var(--default-transition-duration);
  }
</style>
<a
  href={href}
  aria-label={`Learn more about ${listingTitle}`}
  class:list={className}
>
  <span>{listingTitle}</span>
  <Image
    src={listingImageSrc}
    alt={listingTitle}
    width={width}
    height={height}
    layout="full-width"
  />
</a>
