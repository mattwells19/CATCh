---
import InternalLayout from "~/layouts/InternalLayout.astro";

const accordions = [
  {
    q: "Who may audition?",
    a: "Everyone is welcome, including performers from outside CATCh. The standard qualification is completing all three CATCh Performance Track classes (or equivalent experience elsewhere, with PT1 finished or an Artistic Director recommendation). The panel may limit auditioners with very little experience. Eyeing a Harold team? We recommend 6–12 months of experience first.",
  },
  {
    q: "What happens at the audition",
    a: "Think of it like an improv jam: come have fun. You'll do scene work alongside other improvisers and get direction from the panel as you go. Wear something comfy you can move in. That's genuinely all the prep you need.",
  },
  {
    q: "What the coaches look for",
    a: "Bring energy, have fun, and take notes well. The panel watches the fundamentals: making bold choices, supporting your scene partners, physicality, recognizing when a game is heightening, and communicating clearly. More experienced auditioners may also be assessed on second-beat initiations, group games, and character work.",
  },
];
---

<InternalLayout title="Auditions" class="flex flex-col">
  <!-- ===== hero ===== -->
  <header class="bg-(image:--shapes) pt-12 pb-8">
    <div class="mx-auto w-full max-w-3xl px-6 lg:px-0">
      <p
        class="w-fit rounded-sm bg-primary-purple px-3 py-1 text-sm font-bold tracking-wide text-peach"
      >
        Auditions · August 2026
      </p>
      <h1 class="mt-4 font-serif text-6xl font-bold text-primary-purple">
        Join a CATCh team
      </h1>
      <p class="mt-4 max-w-2xl text-lg text-black">
        Be bold, say yes. Tell us a bit about you and what you're itching to play.
        It takes about three minutes and there's nothing to prepare.
      </p>
      <ul class="mt-6 flex flex-wrap gap-3">
        <li
          class="rounded-sm border border-light-purple bg-peach px-4 py-2 font-bold text-primary-purple"
        >
          Sat, Aug 22
        </li>
        <li
          class="rounded-sm border border-light-purple bg-peach px-4 py-2 font-bold text-primary-purple"
        >
          4–6 PM
        </li>
        <li
          class="rounded-sm border border-light-purple bg-peach px-4 py-2 font-bold text-primary-purple"
        >
          The Annex
        </li>
      </ul>
    </div>
  </header>

  <div class="mx-auto w-full max-w-3xl px-6 pb-20 lg:px-0">
    <div class="mt-12 flex flex-col gap-12">
      <!-- ===== Before you register (accordions) ===== -->
      <section>
        <h2 class="font-serif text-2xl font-bold text-primary-purple lg:text-3xl">
          Before you register
        </h2>
        <ul class="mt-6 flex flex-col gap-3">
          {
            accordions.map((item) => (
              <li>
                <details class="group overflow-hidden rounded border border-light-purple bg-peach">
                  <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 text-left font-serif text-lg font-bold text-primary-purple transition-colors hover:bg-primary-purple/5 focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-primary-purple [&::-webkit-details-marker]:hidden">
                    {item.q}
                    <span
                      aria-hidden="true"
                      class="shrink-0 text-2xl leading-none text-coral transition-transform duration-200 group-open:rotate-45"
                    >
                      +
                    </span>
                  </summary>
                  <div class="px-5 pb-5 text-black">{item.a}</div>
                </details>
              </li>
            ))
          }
        </ul>
      </section>

      <!-- ===== Audition registration (Tally embed) ===== -->
      <section>
        <h2 class="mb-6 font-serif text-2xl font-bold text-primary-purple lg:text-3xl">
          Audition registration
        </h2>
        <iframe
          src="https://tally.so/embed/rjbavN?alignLeft=1&hideTitle=1&transparentBackground=1&dynamicHeight=1"
          loading="lazy"
          width="100%"
          height="1788"
          frameborder="0"
          marginheight="0"
          marginwidth="0"
          title="CATCh Audition"></iframe>
      </section>
    </div>
  </div>

  <script is:inline async src="https://tally.so/widgets/embed.js"></script>
</InternalLayout>
