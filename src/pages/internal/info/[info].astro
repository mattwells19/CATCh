---
import InternalLayout from "~/layouts/InternalLayout.astro";
import { getInfoPage } from "~/api/getInfoPage";

const { info: infoSlug } = Astro.params;
if (!infoSlug) {
  return new Response(null, { status: 404 });
}

const infoPage = await getInfoPage(infoSlug);
if (!infoPage) {
  return new Response(null, { status: 404 });
}

const { title, content } = infoPage;
---

<InternalLayout title={title} class="wysiwyg max-w-3xl m-auto mt-4 px-6">
  <article class="wysiwyg" set:html={content} />
</InternalLayout>
