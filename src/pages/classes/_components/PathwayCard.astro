---
import { Image } from "astro:assets";

type Props = {
  image: ImageMetadata;
  imageAlt: string;
  linkText: string;
  href: string;
};

const { href, image, imageAlt, linkText } = Astro.props;
---

<div
  class="rounded overflow-hidden shadow-lg p-2 bg-peach flex flex-col justify-between flex-1 h-full mx-8 md:m-0 my-4"
>
  <div>
    <Image
      src={image}
      alt={imageAlt}
      width={724}
      height={407}
      layout="fixed"
      class="w-full"
    />
    <p class="p-4 pt-6">
      <slot name="description" />
    </p>
  </div>
  <div class="p-4">
    <a class="coral_btn_link w-full min-w-full py-5" href={href}>
      {linkText}
    </a>
  </div>
</div>
